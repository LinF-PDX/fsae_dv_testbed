<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>can_bridge</name>
  <version>0.1.0</version>
  <description>Bridges AckermannDriveStamped commands to CAN frames for the STM32, and publishes encoder feedback.</description>
  <maintainer email="you@example.com">your name</maintainer>
  <license>MIT</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>ackermann_msgs</depend>
  <depend>can_msgs</depend>
  <depend>std_msgs</depend>

  <!-- runtime: the socketcan driver nodes -->
  <exec_depend>ros2_socketcan</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
